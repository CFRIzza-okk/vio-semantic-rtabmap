// R680 实时 TF 树 —— 由 2026-10-19 16:22:35 的 view_frames 抓取结果注释而成
//
// 数据来源(全部实测,非推导):
//   docs/frames_2026-10-19_16.22.35.gv   view_frames 原始输出(30 个帧)
//   docs/tf_tree_view_frames-1.png       该 PDF 的原始渲染
//   各段数值由 ros2 run tf2_ros tf2_echo 逐对实测
//
// 渲染:
//   dot -Tpng docs/tf_tree.dot -o docs/tf_tree.png
//   dot -Tsvg docs/tf_tree.dot -o docs/tf_tree.svg

digraph TF {
    rankdir=TB;
    // 注意:不能用 splines=ortho —— Graphviz 的直角走线**不支持边标签**,
    // 会静默丢弃所有 label(只给一行 Warning)。这张图的价值全在标签上。
    splines=polyline;
    nodesep=0.35;
    ranksep=0.55;
    bgcolor="#FFFFFF";
    node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC",
          fontsize=11, color="#343A40", penwidth=1.2, fillcolor="#FFFFFF",
          margin="0.14,0.07"];
    edge [fontname="Noto Sans CJK SC", fontsize=9, color="#6C757D",
          penwidth=1.3, arrowsize=0.7];

    // 图例
    subgraph cluster_legend {
        label="图例"; fontsize=11; fontname="Noto Sans CJK SC";
        style="rounded"; color="#DEE2E6"; bgcolor="#FAFBFC";
        l1 [label="动态 /tf", fillcolor="#FFF4E6", color="#E8590C", tooltip="每帧重发"];
        l2 [label="静态 /tf_static", fillcolor="#E7F0FF", color="#2F6FED", tooltip="只发一次"];
        l3 [label="@ 20 Hz = 实测频率", fillcolor="#F1F3F5", color="#CED4DA"];
        l1 -> l2 -> l3 [style=invis];
    }

    // ===== Orin: SLAM 输出 =====
    map [label="map\n(全局地图系)", fillcolor="#E6F7F4", color="#12A594", penwidth=1.8];

    // ===== TX1: 里程计与车体 =====
    odom_combined [label="odom_combined\n(连续里程计系)", fillcolor="#FFF4E6", color="#E8590C"];
    base_footprint [label="base_footprint\n(地面投影)", fillcolor="#FFF4E6", color="#E8590C"];
    base_link [label="base_link\n(车体中心,车轮矩形中心)", fillcolor="#FFF4E6", color="#E8590C"];
    laser [label="laser", fillcolor="#FFF4E6", color="#E8590C"];
    gyro_link [label="gyro_link", fillcolor="#FFF4E6", color="#E8590C"];
    wheels [label="left/right_front_link\nleft/right_wheel_link  ×4", fillcolor="#FFF4E6", color="#E8590C"];

    // ===== 相机 (realsense2_camera 自带静态帧) =====
    camera_link [label="camera_link", fillcolor="#E7F0FF", color="#2F6FED"];
    cam_color_frame [label="camera_color_frame", fillcolor="#E7F0FF", color="#2F6FED"];
    cam_color_opt [label="camera_color_optical_frame\n(彩色光学系)", fillcolor="#E7F0FF", color="#2F6FED"];
    cam_depth_frame [label="camera_depth_frame\n(姿态同 camera_link)", fillcolor="#CFE4FF", color="#2F6FED", penwidth=1.8];
    cam_depth_opt [label="camera_depth_optical_frame", fillcolor="#E7F0FF", color="#2F6FED"];
    cam_infra1 [label="camera_infra1_frame", fillcolor="#E7F0FF", color="#2F6FED"];
    cam_infra1_opt [label="camera_infra1_optical_frame", fillcolor="#E7F0FF", color="#2F6FED"];
    cam_aligned [label="camera_aligned_depth_to_infra1_frame", fillcolor="#E7F0FF", color="#2F6FED"];
    cam_infra2 [label="camera_infra2_frame", fillcolor="#E7F0FF", color="#2F6FED"];
    cam_infra2_opt [label="camera_infra2_optical_frame", fillcolor="#E7F0FF", color="#2F6FED"];

    // ===== 边:标注 = 发布者 / 频率 / 实测数值 =====
    map -> odom_combined [
        label="  /rtabmap/rtabmap\n  @ 20.2 Hz  (动态)\n  t=[0, 0, 0] rpy=0\n  ↘ 定位在跑时恒等=未发生回环修正",
        color="#12A594"];

    odom_combined -> base_footprint [
        label="  /r680_ros2_relay ← TX1 robot_pose_ekf\n  @ 20.2 Hz  (动态)\n  t=[0, 0, 0] rpy=[0.83°, 0.59°, 0°]\n  ↘ 静止时也有的姿态抖动=IMU 融合输出",
        color="#E8590C"];

    base_footprint -> base_link [
        label="  TX1 URDF (经 relay 转发)\n  @ 10.2 Hz  (动态)\n  t=[0, 0, 0] rpy=0\n  ↘ 本 launch 用 publish_base_tf:=false 让路,避免双发布",
        color="#E8590C"];

    base_link -> camera_link [
        label="  /r680_base_to_camera\n  静态 /tf_static\n  t=[0.150, 0, 0.165] m\n  pitch=+0.0290 rad (+1.66° 俯视)\n  ↘ 实测:两次地面拟合 0.1639/0.1648 m",
        color="#2F6FED"];

    base_link -> wheels [
        label="  TX1 URDF\n  @ 10.2 Hz\n  x=±0.085 y=±0.0975 r=0.0375"];

    base_footprint -> laser [
        label="  TX1 静态 TF\n  @ 10.2 Hz\n  t=[0.060, 0, 0.200] m\n  yaw=179.9°"];
    base_footprint -> gyro_link [
        label="  TX1 静态 TF\n  @ 10.2 Hz\n  t=[0, 0, 0] rpy=0"];

    camera_link -> cam_color_frame [label="  realsense2_camera (静态)"];
    cam_color_frame -> cam_color_opt [label="  静态 · 90° 光学系"];
    camera_link -> cam_depth_frame [label="  静态\n  rpy=[0, 0, 0]"];
    cam_depth_frame -> cam_depth_opt [label="  静态\n  平移 15 mm · 姿态差 90°"];
    camera_link -> cam_infra1 [label="  静态"];
    cam_infra1 -> cam_infra1_opt [label="  静态"];
    camera_link -> cam_aligned [label="  静态"];
    cam_aligned -> cam_infra1_opt [label="  静态"];
    camera_link -> cam_infra2 [label="  静态"];
    cam_infra2 -> cam_infra2_opt [label="  静态"];

    // ===== 关键说明:哪些帧真正被下游消费 =====
    note1 [shape=note, style="filled", fillcolor="#FFFBEB", color="#D9480F",
           fontsize=10, fontname="Noto Sans CJK SC",
           label="  下游实际用到的三个帧:\n
  ① /scan 的 frame_id = camera_depth_frame
  ② Nav2 局部 costmap 的 global_frame = odom_combined
  ③ Nav2 全局 costmap 的 global_frame = map
  其余相机帧只被点云/图像消息的头引用"];
    rank=same;
    note1 -> camera_link [style=invis];
}
